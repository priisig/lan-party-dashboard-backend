# Production .env for /docker/lan-party-dashboard/ on the server (next to docker-compose.yml). Never commit it.
# Permissions: chmod 600 .env

# --- Database ----------------------------------------------------------------
POSTGRES_DB=lan_dashboard
POSTGRES_USER=lan
# Set a strong password, e.g. `openssl rand -hex 24`. Don't change it after the first start
# (Postgres only applies it to an empty volume).
POSTGRES_PASSWORD=

# --- Image versions ----------------------------------------------------------
# ghcr.io/priisig/lan-party-dashboard-backend / -frontend. The release.yml workflows replace these
# lines via sed on every deploy, so they must stay in this file.
BACKEND_VERSION=0.1.0
FRONTEND_VERSION=0.1.0

# --- Network -----------------------------------------------------------------
# Host port of the frontend container (nginx); the reverse proxy points here. 8080 is taken by the wedding site.
# Docker-published ports bypass ufw - bind to the LAN IP, e.g. FRONTEND_PORT=192.168.1.20:8081
FRONTEND_PORT=8081

# Session cookie only over HTTPS. Keep true behind the TLS reverse proxy; false only for plain-HTTP access.
COOKIE_SECURE=true

# --- Organiser account -------------------------------------------------------
# First organiser (role ORGA), created on start only if no active organiser exists. If an account with this
# e-mail already exists it is promoted instead. Password at least 8 characters. Further organisers: let them
# register and give them the Orga role under Admin -> Teilnehmer. You can then clear the password here.
LAN_BOOTSTRAP_ADMIN_NICKNAME=Orga
LAN_BOOTSTRAP_ADMIN_EMAIL=
LAN_BOOTSTRAP_ADMIN_PASSWORD=

# --- Optional ----------------------------------------------------------------
# true = create a demo event (like the design prototype) when the database is empty. Not for the real event.
LAN_SEED_DEMO=false

TZ=Europe/Zurich

# JVM options for the backend, e.g. to limit the heap.
#JAVA_TOOL_OPTIONS=-Xmx384m
