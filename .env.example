# Local development settings. Copy to .env (git-ignored) – bootRun and the IDE read it automatically.
# Production does NOT use this file; see deploy/.env.example.

# First organiser account (login at http://localhost:5173/login). Created when no organiser exists.
LAN_BOOTSTRAP_ADMIN_NICKNAME=Orga
LAN_BOOTSTRAP_ADMIN_EMAIL=orga@lan.local
LAN_BOOTSTRAP_ADMIN_PASSWORD=orga-pass

# Demo event with servers, tournaments, seats … (only when the database has no events yet).
LAN_SEED_DEMO=true

# Database: by default bootRun starts Postgres from compose.yaml (needs Docker running).
# To use your own Postgres instead, set LAN_DEV_DOCKER_DB=false and fill in DB_URL / DB_USER / DB_PASSWORD.
LAN_DEV_DOCKER_DB=true
#DB_URL=jdbc:postgresql://localhost:5432/lan_dashboard
#DB_USER=lan
#DB_PASSWORD=lan

# Plain HTTP locally, so the session cookie must not be "secure".
COOKIE_SECURE=false
#PORT=8080
